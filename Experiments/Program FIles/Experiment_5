
import numpy as np

# Define customer preference vectors
# Each position represents a product category

customer1 = np.array([4, 2, 5, 1, 3])
customer2 = np.array([3, 2, 4, 1, 2])
customer3 = np.array([1, 5, 1, 4, 5])
customer4 = np.array([5, 1, 4, 2, 3])

# Display customer vectors
print("========== CUSTOMER PREFERENCE VECTORS ==========")

print("Customer 1:", customer1)
print("Customer 2:", customer2)
print("Customer 3:", customer3)
print("Customer 4:", customer4)

# Calculate dot product
print("\n========== DOT PRODUCT ==========")

dot12 = np.dot(customer1, customer2)
dot13 = np.dot(customer1, customer3)
dot14 = np.dot(customer1, customer4)

print("Customer 1 and 2:", dot12)
print("Customer 1 and 3:", dot13)
print("Customer 1 and 4:", dot14)

# Define cosine similarity function
def cosine_similarity(a, b):
    numerator = np.dot(a, b)
    denominator = np.linalg.norm(a) * np.linalg.norm(b)

    if denominator == 0:
        return 0

    return numerator / denominator

# Calculate cosine similarity
print("\n========== COSINE SIMILARITY ==========")

similarity12 = cosine_similarity(customer1, customer2)
similarity13 = cosine_similarity(customer1, customer3)
similarity14 = cosine_similarity(customer1, customer4)

print("Customer 1 and 2:", round(similarity12, 4))
print("Customer 1 and 3:", round(similarity13, 4))
print("Customer 1 and 4:", round(similarity14, 4))

# Compare customer similarities
print("\n========== CUSTOMER COMPARISON ==========")

similarities = {
    "Customer 2": similarity12,
    "Customer 3": similarity13,
    "Customer 4": similarity14
}

for customer, score in similarities.items():
    print(customer, "Similarity:", round(score, 4))

# Identify the most similar customer
most_similar = max(similarities, key=similarities.get)

print("\nMost Similar Customer to Customer 1:", most_similar)

# Compare all customers using a similarity matrix
print("\n========== COMPLETE SIMILARITY MATRIX ==========")

customers = [customer1, customer2, customer3, customer4]

similarity_matrix = np.zeros((4, 4))

for i in range(4):
    for j in range(4):
        similarity_matrix[i][j] = cosine_similarity(
            customers[i], customers[j]
        )

print(np.round(similarity_matrix, 3))

# Identify similarity between every customer pair
print("\n========== PAIRWISE CUSTOMER ANALYSIS ==========")

for i in range(4):
    for j in range(i + 1, 4):
        score = similarity_matrix[i][j]
        print(
            "Customer", i + 1,
            "and Customer", j + 1,
            ":", round(score, 4)
        )

# Final interpretation
print("\n========== FINAL ANALYSIS ==========")

print("Cosine similarity ranges from -1 to 1.")
print("A value closer to 1 indicates similar preferences.")
print("A value closer to 0 indicates less similarity.")
print("Dot product measures the combined magnitude and direction.")

